# =============================================================================
# audio-interv environment template — copy to ``.env`` and fill in.
# =============================================================================
# The ``.env`` file is gitignored. Source it before running anything that
# touches sys.path or a slurm cluster:
#
#     set -a; source .env; set +a
#
# (or use ``direnv allow`` if you prefer.)
# =============================================================================

# ── Project ────────────────────────────────────────────────────────────────
# Absolute path to the repo root. Used to seed PYTHONPATH below.
PROJECT_ROOT=/path/to/repo_root

# Python path: project root + ACE-Step submodule + editing tools.
# (Append, don't overwrite, so your shell's existing PYTHONPATH survives.)
PYTHONPATH=${PROJECT_ROOT}:${PROJECT_ROOT}/src/steering/methods/sae/lib/sae:${PROJECT_ROOT}/src/models/ace_step/ACE:${PROJECT_ROOT}/editing/AudioEditingCode:${PYTHONPATH}

# Where ACE-Step caches its 7.8 GB of weights. Defaults to ``res/ace_step``
# (relative to PROJECT_ROOT) — set this to a shared cache to save disk.
ACE_STEP_CACHE=${PROJECT_ROOT}/res/ace_step

# ── HuggingFace Hub ────────────────────────────────────────────────────────
# Required to push SAEs / SVs / datasets via scripts/hub/*. Optional for download.
HUGGING_FACE_TOKEN=

# Where to cache downloaded SAE / ACE-Step weights.
HF_HOME=${PROJECT_ROOT}/.cache/huggingface

# ── Optional: experiment tracking ──────────────────────────────────────────
WANDB_API_KEY=
WANDB_PROJECT=audio-interv
WANDB_ENTITY=

# ── Slurm clusters                 ─────────────────────────────────────────
HPC_ATHENA_ACCOUNT=plgyour-account-gpu-a100
HPC_ATHENA_PARTITION=plgrid-gpu-a100
HPC_ATHENA_WORKDIR=/net/tscratch/people/youruser/projects/audio-interpretability
HPC_ATHENA_CONDA_ENV=/net/tscratch/people/youruser/envs/audio_int
HPC_ATHENA_PYTHON=${HPC_ATHENA_CONDA_ENV}/bin/python
HPC_PWR_ACCOUNT=hpc-your-account
HPC_PWR_PARTITION=lem-gpu-short
HPC_PWR_WORKDIR=/lustre/your-lustre-path/audio-interpretability
HPC_PWR_VENV=${HPC_PWR_WORKDIR}/venv
